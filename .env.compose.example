# Copy to .env (same directory as docker-compose.yml) and fill in real values.
# Compose reads this file automatically when running `docker compose up`.
# NEVER commit the resulting .env.

# --- URLs (use https in production) ---
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8085
WEBFLUX_URL=http://localhost:8081

# --- Database ---
POSTGRES_DB=digitalmenu
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# --- Object storage (Backblaze B2) ---
BUCKET_URL=https://s3.us-west-001.backblazeb2.com/
BUCKET_NAME=your-bucket-name
BUCKET_S3_ENDPOINT=https://s3.us-west-001.backblazeb2.com
BUCKET_S3_REGION=us-west-001
BUCKET_S3_ACCESSKEY=REPLACE_ME
BUCKET_S3_SECRETKEY=REPLACE_ME

# --- Pagamenti online (Stripe / SumUp) ---
# Ogni locale collega il PROPRIO account Stripe o SumUp dalla dashboard
# (Impostazioni → Pagamenti online): la piattaforma non incassa nulla e non
# servono chiavi Stripe a livello di piattaforma. Vedi docs/PAGAMENTI_SETUP.md nel backend.
#
# Chiave per cifrare (AES-256) le chiavi API dei locali salvate nel database.
# Genera con:  openssl rand -base64 32
# FANNE UN BACKUP SICURO: se la perdi o la cambi, ogni locale dovrà
# reinserire le proprie chiavi Stripe/SumUp.
APP_SECRETS_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTES

# --- Superadmin di piattaforma (console /superadmin) ---
# Imposta email e password SOLO per il primo avvio: il backend crea l'account
# superadmin se non esiste. Dopo il primo login rimuovi la password da .env
# (lasciala vuota) e riavvia il backend: l'account resta nel database.
# Genera la password con:  openssl rand -base64 24
# APP_SUPERADMIN_EMAIL=admin@example.com
# APP_SUPERADMIN_PASSWORD=

# --- Modulo "Contattaci" del sito vetrina (home /) ---
# Indirizzo che riceve le richieste. Vuoto = modulo disattivato (risponde 503).
APP_CONTACT_TO=

# --- Sentry (frontend baked at build time) ---
SENTRY_DSN=
SENTRY_RELEASE=

# --- Bind address for service ports ---
# 127.0.0.1 in production (Caddy fronts everything). Set 0.0.0.0 for local dev.
BIND_ADDR=127.0.0.1

# --- Nightly Postgres backup → B2 ---
# SCHEDULE: cron expression or @daily / @hourly / @weekly
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=30
BACKUP_S3_BUCKET=restaurantflow-backups
BACKUP_S3_PREFIX=postgres-backups
# Leave the next 4 empty to reuse BUCKET_S3_* values above, or set dedicated
# credentials with write-only access to the backups bucket (recommended):
BACKUP_S3_REGION=
BACKUP_S3_ACCESSKEY=
BACKUP_S3_SECRETKEY=
BACKUP_S3_ENDPOINT=
# Optional: gpg-encrypt dumps at rest. Generate: openssl rand -base64 32
BACKUP_PASSPHRASE=
